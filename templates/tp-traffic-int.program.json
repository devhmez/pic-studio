{
  "version": 1,
  "title": "Feu tricolore avec interruption (montage trafficint)",
  "description": "Montage du prof trafficint.DSN (énoncé non fourni : comportement reconstitué). Le programme principal fait le cycle de jour : rouge 9 à 0, orange 2 à 0, vert 9 à 0, une seconde par chiffre. Quand le capteur (LOGICSTATE sur RB0/INT) passe de 1 à 0 (front descendant), l’interruption fait le mode nuit : orange clignotant et « A » affiché tant que le capteur reste à 0, puis le cycle reprend où il s’était arrêté (les feux sont réécrits chaque seconde). Au démarrage, mettre le capteur à 1 (jour).",
  "clockHz": 8000000,
  "style": {
    "bitNotation": "pin",
    "tris": { "A": "auto", "B": "auto" },
    "macros": true,
    "sections": "demux",
    "compactAssign": false,
    "echoRegister": false,
    "oneLineBranches": false,
    "packLines": false
  },
  "signals": [
    {
      "id": "capteur",
      "name": "CAPTEUR",
      "pin": "RB0",
      "dir": "in",
      "label": "Capteur de luminosité",
      "activeLevel": 1,
      "device": "logicstate",
      "componentId": "LS1"
    },
    {
      "id": "rouge",
      "name": "ROUGE",
      "pin": "RB2",
      "dir": "out",
      "label": "Feu rouge",
      "activeLevel": 1,
      "device": "lamp",
      "componentId": "TL1"
    },
    {
      "id": "orange",
      "name": "ORANGE",
      "pin": "RB3",
      "dir": "out",
      "label": "Feu orange",
      "activeLevel": 1,
      "device": "lamp",
      "componentId": "TL1"
    },
    {
      "id": "vert",
      "name": "VERT",
      "pin": "RB4",
      "dir": "out",
      "label": "Feu vert",
      "activeLevel": 1,
      "device": "lamp",
      "componentId": "TL1"
    }
  ],
  "buses": [
    {
      "id": "afficheur",
      "name": "AFFICHEUR",
      "port": "A",
      "lsb": 0,
      "width": 4,
      "dir": "out",
      "label": "Afficheur 7 segments BCD",
      "device": "bcd",
      "componentId": "SEG1"
    }
  ],
  "constants": [],
  "variables": [{ "name": "compte", "type": "unsigned char" }],
  "interrupts": { "int": { "edge": "falling" }, "gie": true },
  "init": [
    { "id": "s1", "kind": "set", "signal": "rouge", "value": 0 },
    { "id": "s2", "kind": "set", "signal": "orange", "value": 0 },
    { "id": "s3", "kind": "set", "signal": "vert", "value": 0 },
    {
      "id": "s4",
      "kind": "display",
      "bus": "afficheur",
      "value": { "kind": "num", "value": 0, "radix": 16 }
    }
  ],
  "loop": [
    {
      "id": "s5",
      "kind": "repeat",
      "times": 10,
      "counter": "compte",
      "body": [
        { "id": "s6", "kind": "set", "signal": "rouge", "value": 1 },
        { "id": "s7", "kind": "set", "signal": "orange", "value": 0 },
        { "id": "s8", "kind": "set", "signal": "vert", "value": 0 },
        {
          "id": "s9",
          "kind": "display",
          "bus": "afficheur",
          "value": {
            "kind": "bin",
            "op": "-",
            "left": { "kind": "num", "value": 9 },
            "right": { "kind": "var", "name": "compte" }
          }
        },
        { "id": "s10", "kind": "delay", "ms": 1000 }
      ],
      "lead": "Rouge : décompte de 9 à 0 (feux réécrits chaque seconde, utile au retour du mode nuit)"
    },
    {
      "id": "s11",
      "kind": "repeat",
      "times": 3,
      "counter": "compte",
      "body": [
        { "id": "s12", "kind": "set", "signal": "rouge", "value": 0 },
        { "id": "s13", "kind": "set", "signal": "orange", "value": 1 },
        { "id": "s14", "kind": "set", "signal": "vert", "value": 0 },
        {
          "id": "s15",
          "kind": "display",
          "bus": "afficheur",
          "value": {
            "kind": "bin",
            "op": "-",
            "left": { "kind": "num", "value": 2 },
            "right": { "kind": "var", "name": "compte" }
          }
        },
        { "id": "s16", "kind": "delay", "ms": 1000 }
      ],
      "lead": "Orange : décompte de 2 à 0"
    },
    {
      "id": "s17",
      "kind": "repeat",
      "times": 10,
      "counter": "compte",
      "body": [
        { "id": "s18", "kind": "set", "signal": "rouge", "value": 0 },
        { "id": "s19", "kind": "set", "signal": "orange", "value": 0 },
        { "id": "s20", "kind": "set", "signal": "vert", "value": 1 },
        {
          "id": "s21",
          "kind": "display",
          "bus": "afficheur",
          "value": {
            "kind": "bin",
            "op": "-",
            "left": { "kind": "num", "value": 9 },
            "right": { "kind": "var", "name": "compte" }
          }
        },
        { "id": "s22", "kind": "delay", "ms": 1000 }
      ],
      "lead": "Vert : décompte de 9 à 0"
    }
  ],
  "functions": [
    {
      "id": "f1",
      "name": "interrupt",
      "kind": "interrupt",
      "body": [
        {
          "id": "s23",
          "kind": "if",
          "branches": [
            {
              "id": "b1",
              "cond": { "kind": "flag", "flag": "INTF", "value": 1 },
              "body": [
                {
                  "id": "s24",
                  "kind": "while",
                  "cond": { "kind": "pin", "signal": "capteur", "value": 0 },
                  "body": [
                    { "id": "s25", "kind": "set", "signal": "rouge", "value": 0 },
                    { "id": "s26", "kind": "set", "signal": "orange", "value": 0 },
                    { "id": "s27", "kind": "set", "signal": "vert", "value": 0 },
                    {
                      "id": "s28",
                      "kind": "display",
                      "bus": "afficheur",
                      "value": { "kind": "num", "value": 10, "radix": 16 },
                      "comment": "Afficher la lettre 'A'"
                    },
                    { "id": "s29", "kind": "set", "signal": "orange", "value": 1 },
                    { "id": "s30", "kind": "delay", "ms": 500 },
                    { "id": "s31", "kind": "set", "signal": "orange", "value": 0 },
                    { "id": "s32", "kind": "delay", "ms": 500 }
                  ],
                  "lead": "Mode nuit : orange clignotant et \"A\" tant que le capteur est à 0"
                },
                {
                  "id": "s33",
                  "kind": "clearFlag",
                  "flag": "INTF",
                  "comment": "Effacer le drapeau INTF"
                }
              ],
              "comment": "Interruption RB0/INT : le capteur passe à 0 (nuit)"
            }
          ],
          "otherwise": null
        }
      ],
      "lead": "Programme d'interruption : appelé quand le capteur passe de 1 à 0 (front descendant sur RB0/INT)"
    }
  ]
}
